#!/usr/bin/env bash
#
# Pre-commit hook: keep fabrication outputs and README renders in lockstep
# with the design.
#
# When the schematic or PCB is part of the commit, regenerate all fab outputs
# (gerbers + drill + pick-and-place + BOM) via scripts/regen-fab.sh and stage
# export/ so the checked-in outputs never drift from the source.
#
# README assets regenerate per source file via scripts/render-readme-assets.sh:
# a staged PCB rerenders the board views (3D PNGs + flat SVGs), a staged
# schematic rerenders schematic.svg; docs/readme-assets/ is then staged.
#
# A staged PCB also reruns scripts/render-annotated-remote.py --only board, so
# the annotated board SVGs embed the new board PNGs. A staged board PNG without
# the PCB does the same. The case sets stay out: their ImageMagick step can
# change the PNG bytes without a design change.
#
# The case renders come from ../c6remote-explode and are copied in by hand. If a
# staged file is a source of them (PCB, board_extras.py, case model), the hook
# runs scripts/stamp-case-renders.py --check. It only warns, and the hook never
# stages docs/readme-assets/case-renders.stamp.
#
# A staged PCB also refreshes c6remote-kicad/ibom.html via scripts/gen-ibom.sh,
# so the pre-fab pin-1 walk artifact never lags the board. It is gitignored and
# deliberately not staged. Non-fatal: the generator needs KiCad's bundled Python
# and a first-run network clone, neither of which should be able to block a
# commit.
#
# Install (once per clone):
#   git config core.hooksPath scripts/hooks
#
# Skip for a one-off commit:
#   git commit --no-verify
#
# Note: gerber/drill headers embed a creation timestamp, so any commit that
# touches the board will restage all of export/ even if geometry is unchanged.
#
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Policy guard: never let a co-author / AI-attribution trailer enter the repo.
# Scans staged *additions* across all files (AGENTS.md included). Matches real
# trailer-shaped lines and known AI-bot emails, so prose documenting the rule
# (e.g. "no Co-Authored-By trailers") does not trip it.
ADDED="$(git diff --cached --unified=0 --no-color -- . ':(exclude)*.gbr' ':(exclude)*.drl' ':(exclude)scripts/hooks/*' | grep -E '^\+' | grep -vE '^\+\+\+' || true)"
if grep -iqE '^\+[[:space:]]*co[- ]?authored[- ]?by:[[:space:]]*.+<[^>]*@' <<<"$ADDED" \
	|| grep -iqE 'noreply@anthropic\.com|[0-9]+\+copilot@users\.noreply\.github\.com' <<<"$ADDED"; then
	echo "[pre-commit] BLOCKED: a staged change adds a co-author / AI-attribution trailer" >&2
	echo "[pre-commit] Repo forbids Co-Authored-By / Claude / Copilot attribution. Remove it, or use --no-verify." >&2
	exit 1
fi

# Policy guard: block a staged c6remote.kicad_pro that moved on the guarded
# board-setting fields. Almost always an eeschema save clobbering the project
# file from the stale copy it loaded at open time, not an intended edit.
"$REPO_ROOT/scripts/check-kicad-pro-drift.py"

STAGED="$(git diff --cached --name-only)"
SCH_STAGED=false
PCB_STAGED=false
grep -qE '^c6remote-kicad/c6remote\.kicad_sch$' <<<"$STAGED" && SCH_STAGED=true
grep -qE '^c6remote-kicad/c6remote\.kicad_pcb$' <<<"$STAGED" && PCB_STAGED=true

# Warn, never block, when this commit moves a source of the hand-copied case renders.
"$REPO_ROOT/scripts/stamp-case-renders.py" --check --if-staged \
	|| echo "[pre-commit] WARNING: stamp-case-renders.py failed, case render staleness unknown" >&2

# The annotated board SVGs embed the board PNGs, so a PNG-only rerender must refresh them.
if ! $PCB_STAGED && grep -qE '^docs/readme-assets/board-3d-rotated-(top|bottom)\.png$' <<<"$STAGED"; then
	echo "[pre-commit] board PNG staged -> rerendering annotated board SVGs"
	python3 "$REPO_ROOT/scripts/render-annotated-remote.py" --only board >/dev/null
	git add -- \
		"$REPO_ROOT/docs/readme-assets/board-front-annotated.svg" \
		"$REPO_ROOT/docs/readme-assets/board-front-annotated-dark.svg" \
		"$REPO_ROOT/docs/readme-assets/board-back-annotated.svg" \
		"$REPO_ROOT/docs/readme-assets/board-back-annotated-dark.svg"
fi

# Only regenerate when a design file is actually part of this commit.
if ! $SCH_STAGED && ! $PCB_STAGED; then
	exit 0
fi

echo "[pre-commit] schematic/PCB staged -> regenerating fabrication outputs"
"$REPO_ROOT/scripts/regen-fab.sh"
git add "$REPO_ROOT/c6remote-kicad/export/"
echo "[pre-commit] export/ regenerated and staged"

if $PCB_STAGED && $SCH_STAGED; then
	echo "[pre-commit] PCB + schematic staged -> rerendering all README assets"
	"$REPO_ROOT/scripts/render-readme-assets.sh" --only all
elif $PCB_STAGED; then
	echo "[pre-commit] PCB staged -> rerendering README board views"
	"$REPO_ROOT/scripts/render-readme-assets.sh" --only board
else
	echo "[pre-commit] schematic staged -> rerendering README schematic SVG"
	"$REPO_ROOT/scripts/render-readme-assets.sh" --only schematic
fi
if $PCB_STAGED; then
	echo "[pre-commit] PCB staged -> rerendering annotated board SVGs"
	python3 "$REPO_ROOT/scripts/render-annotated-remote.py" --only board >/dev/null
fi
git add -- "$REPO_ROOT/docs/readme-assets/" ':(top,exclude)docs/readme-assets/case-renders.stamp'
echo "[pre-commit] docs/readme-assets/ regenerated and staged"

if $PCB_STAGED; then
	echo "[pre-commit] PCB staged -> refreshing ibom.html (not staged, gitignored)"
	if "$REPO_ROOT/scripts/gen-ibom.sh" >/dev/null; then
		echo "[pre-commit] ibom.html refreshed"
	else
		echo "[pre-commit] WARNING: gen-ibom.sh failed, ibom.html is stale" >&2
		echo "[pre-commit] Run scripts/gen-ibom.sh by hand before any pin-1 walk." >&2
	fi
fi
