(version 1)

# JLCPCB 2-layer 1oz capability limits, expressed as KiCad custom DRC rules.
# KiCad auto-loads <project>.kicad_dru next to the .kicad_pro, no setup needed.
# Values from the JLCPCB PCB capabilities page (2-layer, standard PCB service).
# Project board-setup constraints are already stricter for plain track width and
# copper clearance (0.2mm / 0.2032mm vs JLC's 0.127mm); these rules add the
# checks the board-setup fields cannot express: hole-to-hole spacing, per-type
# hole-to-copper clearances, annular ring, edge clearance, and silk clearance.

(rule "JLC trace width (outer)"
	(layer outer)
	(condition "A.Type == 'track'")
	(constraint track_width (min 0.127mm)))

(rule "JLC trace spacing (outer)"
	(layer outer)
	(condition "A.Type == 'track' && B.Type == A.Type")
	(constraint clearance (min 0.127mm)))

(rule "JLC copper to board edge"
	(condition "A.Type == 'track' || A.Type == 'zone' || A.Type == 'pad'")
	(constraint edge_clearance (min 0.3mm)))

(rule "JLC drill size (mechanical)"
	(constraint hole_size (min 0.3mm) (max 6.3mm)))

(rule "JLC via hole size"
	(condition "A.Type == 'via'")
	(constraint hole_size (min 0.3mm)))

(rule "JLC via diameter"
	(condition "A.Type == 'via'")
	(constraint via_diameter (min 0.45mm)))

(rule "JLC via annular ring"
	(condition "A.Type == 'via'")
	(constraint annular_width (min 0.075mm)))

(rule "JLC PTH annular ring"
	(condition "A.Type == 'pad' && A.isPlated()")
	(constraint annular_width (min 0.25mm)))

(rule "JLC hole to hole (different nets)"
	(condition "A.Type == 'hole' && B.Type == 'hole' && A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm)))

(rule "JLC via to via (same net)"
	(condition "A.Type == 'via' && B.Type == 'via' && A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm)))

(rule "JLC SMD pad to SMD pad (different nets)"
	(condition "A.Type == 'pad' && !A.hasHole() && B.Type == 'pad' && !B.hasHole() && A.Net != B.Net")
	(constraint clearance (min 0.127mm)))

(rule "JLC PTH pad to PTH pad (different nets)"
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'pad' && B.isPlated() && A.Net != B.Net")
	(constraint clearance (min 0.5mm)))

(rule "JLC PTH hole to track"
	(condition "A.Type == 'pad' && A.isPlated() && B.Type == 'track'")
	(constraint hole_clearance (min 0.33mm)))

(rule "JLC via hole to track"
	(condition "A.Type == 'via' && B.Type == 'track'")
	(constraint hole_clearance (min 0.254mm)))

(rule "JLC NPTH hole to track"
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track'")
	(constraint hole_clearance (min 0.254mm)))

(rule "JLC silkscreen to pad"
	(layer outer)
	(condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic')")
	(constraint silk_clearance (min 0.15mm)))
